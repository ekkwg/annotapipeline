manifest {
    name = 'AnnotaPipeline'
    nextflowVersion = '!>=25.10.4'
    description = 'Eukaryotic protein annotation and optional multi-omics evidence'
}

params {
    basename = null
    organism = null
    genome = null
    protein = null
    gff = null
    min_length = 0
    software_id = null
    tools = [:]
    references = [:]
    augustus = [:]
    blast = [:]
    interproscan = [:]
    hmmer = [:]
    rpsblast = [:]
    kallisto = null
    proteomics = null

    // Conservative defaults; set these from the scheduler or a site config.
    cpus = 1
    memory = '2 GB'
    time = '2 h'
}

process {
    errorStrategy = 'terminate'
    cpus = params.cpus
    memory = params.memory
    time = params.time

    // avoid concurrent scans of the same large signature data on shared storage
    withLabel: interproscan {
        maxForks = 1
    }
}

workflow.output.mode = 'copy'
workflow.output.overwrite = true

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
    }
    // Enable engines only; bind pinned process containers or Conda envs
    // in a site-specific config for real scientific tools.
    docker {
        docker.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    conda {
        conda.enabled = true
    }
}
